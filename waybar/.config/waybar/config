{
  "layer": "top",
  "position": "top",
  "height": 32,

  "modules-left": ["hyprland/workspaces"],
  "modules-center": [],
  "modules-right": ["network#vpn", "cpu", "memory", "network", "clock"],

  "network#vpn": {
    "interface": "proton0",
    "format": "VPN",
    "format-disconnected": "",
    "tooltip-format": "{ifname} {ipaddr}"
  },

  "hyprland/workspaces": {
    "all-outputs": true,
    "format": "{name}"
  },

  "cpu": {
    "interval": 2,
    "format": "CPU {usage}%"
  },

  "memory": {
    "interval": 5,
    "format": "RAM {used}G"
  },

  "network": {
    "interval": 3,
    "format-wifi": "WiFi {essid} {signalStrength}%",
    "format-ethernet": "Homelab",
    "format-disconnected": "No net",
    "tooltip-format-wifi": "{essid}\n{ipaddr}/{cidr}\n{frequency} MHz  {signalStrength}%",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr}",
    "tooltip-format-disconnected": "disconnected"
  },

  "clock": {
    "interval": 60,
    "format": "{:%Y-%m-%d %H:%M}"
  }

}

